---
// Page générée depuis /nous-situer/ par tools/build_fragments.py.
// Le contenu, lui, est écrit à la main dans src/fragments/nous-situer-content.html.
import BaseLayout from '../layouts/BaseLayout.astro';
import head from '../fragments/nous-situer-head.html?raw';
import content from '../fragments/nous-situer-content.html?raw';
import scripts from '../fragments/nous-situer-scripts.html?raw';
import { withBase } from '../lib/withBase.js';

const bodyClass = "";
---
<BaseLayout bodyClass={bodyClass} slug="nous-situer">
  <Fragment slot="head" set:html={withBase(head)} />
  <Fragment set:html={withBase(content)} />
  <Fragment slot="scripts" set:html={withBase(scripts)} />
</BaseLayout>
