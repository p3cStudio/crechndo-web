---
// Page générée depuis /notre-equipe/ par tools/build_fragments.py.
// Le contenu, lui, est écrit à la main dans src/fragments/notre-equipe-content.html.
import BaseLayout from '../layouts/BaseLayout.astro';
import head from '../fragments/notre-equipe-head.html?raw';
import content from '../fragments/notre-equipe-content.html?raw';
import scripts from '../fragments/notre-equipe-scripts.html?raw';
import { withBase } from '../lib/withBase.js';

const bodyClass = "";
---
<BaseLayout bodyClass={bodyClass} slug="notre-equipe">
  <Fragment slot="head" set:html={withBase(head)} />
  <Fragment set:html={withBase(content)} />
  <Fragment slot="scripts" set:html={withBase(scripts)} />
</BaseLayout>
