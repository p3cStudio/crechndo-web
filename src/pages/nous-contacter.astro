---
// Page générée depuis /nous-contacter/ par tools/build_fragments.py.
// Le contenu, lui, est écrit à la main dans src/fragments/nous-contacter-content.html.
import BaseLayout from '../layouts/BaseLayout.astro';
import head from '../fragments/nous-contacter-head.html?raw';
import content from '../fragments/nous-contacter-content.html?raw';
import scripts from '../fragments/nous-contacter-scripts.html?raw';
import { withBase } from '../lib/withBase.js';

const bodyClass = "";
---
<BaseLayout bodyClass={bodyClass} slug="nous-contacter">
  <Fragment slot="head" set:html={withBase(head)} />
  <Fragment set:html={withBase(content)} />
  <Fragment slot="scripts" set:html={withBase(scripts)} />
</BaseLayout>
