---
// Page générée depuis /la-micro-creche/ par tools/build_fragments.py.
// Le contenu, lui, est écrit à la main dans src/fragments/la-micro-creche-content.html.
import BaseLayout from '../layouts/BaseLayout.astro';
import head from '../fragments/la-micro-creche-head.html?raw';
import content from '../fragments/la-micro-creche-content.html?raw';
import scripts from '../fragments/la-micro-creche-scripts.html?raw';
import { withBase } from '../lib/withBase.js';

const bodyClass = "";
---
<BaseLayout bodyClass={bodyClass} slug="la-micro-creche">
  <Fragment slot="head" set:html={withBase(head)} />
  <Fragment set:html={withBase(content)} />
  <Fragment slot="scripts" set:html={withBase(scripts)} />
</BaseLayout>
