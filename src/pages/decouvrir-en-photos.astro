---
// Page générée depuis /decouvrir-en-photos/ par tools/build_fragments.py.
// Le contenu, lui, est écrit à la main dans src/fragments/decouvrir-en-photos-content.html.
import BaseLayout from '../layouts/BaseLayout.astro';
import head from '../fragments/decouvrir-en-photos-head.html?raw';
import content from '../fragments/decouvrir-en-photos-content.html?raw';
import scripts from '../fragments/decouvrir-en-photos-scripts.html?raw';
import { withBase } from '../lib/withBase.js';

const bodyClass = "";
---
<BaseLayout bodyClass={bodyClass} slug="decouvrir-en-photos">
  <Fragment slot="head" set:html={withBase(head)} />
  <Fragment set:html={withBase(content)} />
  <Fragment slot="scripts" set:html={withBase(scripts)} />
</BaseLayout>
