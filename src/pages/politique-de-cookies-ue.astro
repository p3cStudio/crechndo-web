---
// Page générée depuis /politique-de-cookies-ue/ par tools/build_fragments.py.
// Le contenu, lui, est écrit à la main dans src/fragments/politique-de-cookies-ue-content.html.
import BaseLayout from '../layouts/BaseLayout.astro';
import head from '../fragments/politique-de-cookies-ue-head.html?raw';
import content from '../fragments/politique-de-cookies-ue-content.html?raw';
import scripts from '../fragments/politique-de-cookies-ue-scripts.html?raw';
import { withBase } from '../lib/withBase.js';

const bodyClass = "";
---
<BaseLayout bodyClass={bodyClass} slug="politique-de-cookies-ue">
  <Fragment slot="head" set:html={withBase(head)} />
  <Fragment set:html={withBase(content)} />
  <Fragment slot="scripts" set:html={withBase(scripts)} />
</BaseLayout>
