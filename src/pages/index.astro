---
// Page générée depuis / par tools/build_fragments.py.
// Le contenu, lui, est écrit à la main dans src/fragments/index-content.html.
import BaseLayout from '../layouts/BaseLayout.astro';
import head from '../fragments/index-head.html?raw';
import content from '../fragments/index-content.html?raw';
import scripts from '../fragments/index-scripts.html?raw';
import { withBase } from '../lib/withBase.js';

const bodyClass = "";
---
<BaseLayout bodyClass={bodyClass} slug="index">
  <Fragment slot="head" set:html={withBase(head)} />
  <Fragment set:html={withBase(content)} />
  <Fragment slot="scripts" set:html={withBase(scripts)} />
</BaseLayout>
