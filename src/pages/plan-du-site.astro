---
// Page générée depuis /plan-du-site/ par tools/build_fragments.py.
// Le contenu, lui, est écrit à la main dans src/fragments/plan-du-site-content.html.
import BaseLayout from '../layouts/BaseLayout.astro';
import head from '../fragments/plan-du-site-head.html?raw';
import content from '../fragments/plan-du-site-content.html?raw';
import scripts from '../fragments/plan-du-site-scripts.html?raw';
import { withBase } from '../lib/withBase.js';

const bodyClass = "";
---
<BaseLayout bodyClass={bodyClass} slug="plan-du-site">
  <Fragment slot="head" set:html={withBase(head)} />
  <Fragment set:html={withBase(content)} />
  <Fragment slot="scripts" set:html={withBase(scripts)} />
</BaseLayout>
