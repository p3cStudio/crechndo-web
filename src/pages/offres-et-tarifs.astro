---
// Page générée depuis /offres-et-tarifs/ par tools/build_fragments.py.
// Le contenu, lui, est écrit à la main dans src/fragments/offres-et-tarifs-content.html.
import BaseLayout from '../layouts/BaseLayout.astro';
import head from '../fragments/offres-et-tarifs-head.html?raw';
import content from '../fragments/offres-et-tarifs-content.html?raw';
import scripts from '../fragments/offres-et-tarifs-scripts.html?raw';
import { withBase } from '../lib/withBase.js';

const bodyClass = "";
---
<BaseLayout bodyClass={bodyClass} slug="offres-et-tarifs">
  <Fragment slot="head" set:html={withBase(head)} />
  <Fragment set:html={withBase(content)} />
  <Fragment slot="scripts" set:html={withBase(scripts)} />
</BaseLayout>
