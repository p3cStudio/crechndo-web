---
// Page générée depuis /mentions-legales/ par tools/build_fragments.py.
// Le contenu, lui, est écrit à la main dans src/fragments/mentions-legales-content.html.
import BaseLayout from '../layouts/BaseLayout.astro';
import head from '../fragments/mentions-legales-head.html?raw';
import content from '../fragments/mentions-legales-content.html?raw';
import scripts from '../fragments/mentions-legales-scripts.html?raw';
import { withBase } from '../lib/withBase.js';

const bodyClass = "";
---
<BaseLayout bodyClass={bodyClass} slug="mentions-legales">
  <Fragment slot="head" set:html={withBase(head)} />
  <Fragment set:html={withBase(content)} />
  <Fragment slot="scripts" set:html={withBase(scripts)} />
</BaseLayout>
