---
// Page générée depuis /nos-partenaires/ par tools/build_fragments.py.
// Le contenu, lui, est écrit à la main dans src/fragments/nos-partenaires-content.html.
import BaseLayout from '../layouts/BaseLayout.astro';
import head from '../fragments/nos-partenaires-head.html?raw';
import content from '../fragments/nos-partenaires-content.html?raw';
import scripts from '../fragments/nos-partenaires-scripts.html?raw';
import { withBase } from '../lib/withBase.js';

const bodyClass = "";
---
<BaseLayout bodyClass={bodyClass} slug="nos-partenaires">
  <Fragment slot="head" set:html={withBase(head)} />
  <Fragment set:html={withBase(content)} />
  <Fragment slot="scripts" set:html={withBase(scripts)} />
</BaseLayout>
