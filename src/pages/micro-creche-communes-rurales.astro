---
// Page écrite à la main (elle n'existait pas sous WordPress) : page de
// proximité pour les communes rurales voisines.
// Contenu : src/fragments/micro-creche-communes-rurales-content.html
// Métadonnées : src/fragments/micro-creche-communes-rurales-head.html
// (régénérables par tools/seo.py).
import BaseLayout from '../layouts/BaseLayout.astro';
import head from '../fragments/micro-creche-communes-rurales-head.html?raw';
import content from '../fragments/micro-creche-communes-rurales-content.html?raw';
import scripts from '../fragments/micro-creche-communes-rurales-scripts.html?raw';
import { withBase } from '../lib/withBase.js';

const bodyClass = "";
---
<BaseLayout bodyClass={bodyClass} slug="micro-creche-communes-rurales">
  <Fragment slot="head" set:html={withBase(head)} />
  <Fragment set:html={withBase(content)} />
  <Fragment slot="scripts" set:html={withBase(scripts)} />
</BaseLayout>
