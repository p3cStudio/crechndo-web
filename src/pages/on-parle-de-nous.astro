---
// Page générée depuis /on-parle-de-nous/ par tools/build_fragments.py.
// Le contenu, lui, est écrit à la main dans src/fragments/on-parle-de-nous-content.html.
import BaseLayout from '../layouts/BaseLayout.astro';
import head from '../fragments/on-parle-de-nous-head.html?raw';
import content from '../fragments/on-parle-de-nous-content.html?raw';
import scripts from '../fragments/on-parle-de-nous-scripts.html?raw';
import { withBase } from '../lib/withBase.js';

const bodyClass = "";
---
<BaseLayout bodyClass={bodyClass} slug="on-parle-de-nous">
  <Fragment slot="head" set:html={withBase(head)} />
  <Fragment set:html={withBase(content)} />
  <Fragment slot="scripts" set:html={withBase(scripts)} />
</BaseLayout>
